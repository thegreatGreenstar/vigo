<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by install.sh; the placeholders are filled in from that run. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.vigo.opencode</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/libexec/opencode-serve-macos.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OPENCODE_HOSTNAME</key>
        <string>tailscale</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/vigo/opencode.err</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/vigo/opencode.out</string>
</dict>
</plist>
