<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by install.sh; the placeholders are filled in from that run. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.vigo.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>vigo</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__CHECKOUT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Git calls ssh from PATH, and Homebrew's ssh does not know Apple's
             UseKeychain in ~/.ssh/config; the system one unlocks the read key. -->
        <key>GIT_SSH_COMMAND</key>
        <string>/usr/bin/ssh</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/vigo/vigo.err</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/vigo/vigo.out</string>
</dict>
</plist>
