<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keep Vigo's container running at login, on macOS.

  deploy/container/install.sh fills in __KIT__ and __HOME__ and loads it.  Set
  VIGO_BIND_ADDRESS when another device must reach this one through the podman
  machine; the install writes it here and keeps it on a reinstall.  The
  default is 127.0.0.1.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.vigo.container</string>

    <key>ProgramArguments</key>
    <array>
        <string>__KIT__/run.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/vigo/container.err</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/vigo/container.out</string>
</dict>
</plist>
