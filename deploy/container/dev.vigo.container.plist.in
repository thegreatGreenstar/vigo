<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keep Vigo's pod running at login, on macOS.

  install.sh fills in the two placeholders and loads this file:

    deploy/container/install.sh

  VIGO_PEER_PORT and VIGO_PEER_BIND are added when another device must reach
  this one, because a published port is the only way the podman machine lets it
  through.  The agent's port is published the same way by run.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.vigo.container</string>

    <key>ProgramArguments</key>
    <array>
        <string>__KIT__/run.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/vigo/container.err</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/vigo/container.out</string>
</dict>
</plist>
