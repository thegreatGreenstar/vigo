[Unit]
Description=Vigo and its agent in a rootless podman pod
After=network-online.target tailscaled.service vigo-ssh-agent.service
Wants=network-online.target
Requires=vigo-ssh-agent.service

[Service]
Type=exec
WorkingDirectory=%h
# The settings, the peer's password, and the credentials systemd unseals.
Environment=VIGO_CONTAINER_ROOT=%h/.local/share/vigo
Environment=VIGO_CONFIG_FILE=%h/.config/vigo/vigo.json
Environment=VIGO_PEER_PASSWORD_FILE=%h/.config/vigo/peer.password
LoadCredentialEncrypted=vigo-token:%h/.config/vigo/vigo-token.cred
LoadCredentialEncrypted=opencode-password:%h/.config/vigo/opencode.cred
LoadCredentialEncrypted=peer-password:%h/.config/vigo/peer-api.cred
# Optional: Vigo's own GitHub CLI token.  With no path, a missing credential in
# ~/.config/credstore.encrypted/gh-token is not an error.
LoadCredentialEncrypted=gh-token
# The launcher lives outside the checkout, so /vigo upgrade cannot change how
# the pod starts.  Re-run deploy/container/install.sh after editing it.
ExecStart=%h/.local/libexec/vigo-container/run.sh

Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
Delegate=yes
# No NoNewPrivileges or PrivateTmp here: rootless podman needs file-capability
# newuidmap, and a private /tmp mount stops it from mapping the subordinate
# range (newuidmap: write to uid_map failed).  The containers themselves get
# no-new-privileges and their own bounded /tmp tmpfs.
PrivateTmp=no
UMask=0077

[Install]
WantedBy=default.target
