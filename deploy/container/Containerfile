# Vigo and its own OpenCode, in one rootless container.
#
# The build context is made by deploy/build-container.sh: it copies the host's
# opencode and gh next to this file, so the image runs the same builds the host
# does.  Nothing secret goes in here.
#
# There is no USER line on purpose, matching deploy/container/run.sh: a rootless
# runtime maps container root onto the human who started it, so the mounted
# checkout, settings and state are that person's files.  The Linux launcher
# keeps that mapping with --userns=keep-id:uid=0,gid=0 and drops every
# capability, so root inside the namespace has no privilege over the host.
FROM docker.io/library/python:3.14-slim

ARG OPENCODE_VERSION=unknown
LABEL org.opencontainers.image.title="vigo" \
      org.opencontainers.image.description="Vigo and its own OpenCode, rootless" \
      org.opencontainers.image.version="${OPENCODE_VERSION}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        openssh-client \
        ripgrep \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    HOME=/home/vigo \
    XDG_CONFIG_HOME=/home/vigo/.config \
    XDG_DATA_HOME=/home/vigo/.local/share \
    XDG_STATE_HOME=/home/vigo/.local/state \
    XDG_CACHE_HOME=/tmp/cache \
    SSH_AUTH_SOCK=/run/vigo/ssh-agent.sock \
    VIGO_CONFIG=/config/vigo.json \
    VIGO_CONTAINER=1

COPY --chmod=0755 opencode /usr/local/bin/opencode
COPY --chmod=0755 gh /usr/local/bin/gh
COPY --chmod=0755 vigo-entrypoint.py /usr/local/libexec/vigo-entrypoint.py
COPY ssh_config known_hosts /etc/vigo/

# The checkout and home are bind mounts; these are only the mount points.
RUN install -d -m 0755 /vigo /run/vigo /run/secrets /config /home/vigo

WORKDIR /vigo
ENTRYPOINT ["/usr/local/bin/python3", "/usr/local/libexec/vigo-entrypoint.py"]
