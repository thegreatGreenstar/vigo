# A small image for Vigo: Python, git and an SSH client, and nothing else.
#
#   podman build -t localhost/vigo deploy/container
#
# The checkout is mounted, not copied, so /vigo upgrade pulls into the same tree
# that runs and a rebuild is needed only when the base or these packages change.
#
# There is no USER line on purpose.  A rootless runtime maps container root onto
# the human who started it, so the mounted checkout and state are that person's
# files.  A container user would be in the subuid range and could not write them.
FROM docker.io/library/python:3.14-slim

# git runs /vigo upgrade and the agents' work; ssh reaches the git remote.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client \
 && rm -rf /var/lib/apt/lists/*

# The client's own configuration: one key, pinned host keys, no prompt.
COPY ssh_config known_hosts /etc/vigo/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["python3", "-m", "vigo"]
